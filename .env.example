WEB_APPLICATION_URL=
WEB_APPLICATION_CREDENTIAL=
EDGE_AUTH_SECRET=
# Empty TLS paths mean plaintext WebSocket behind a private/trusted reverse-proxy boundary only.
# Direct external WSS requires both paths; provide real certificate paths in deployment config.
TLS_CERT_PATH=
TLS_KEY_PATH=
MEDIA_INGEST_HOST=0.0.0.0
MEDIA_INGEST_PORT=8443
MEDIA_INGEST_PATH=/api/v1/cameras/{camera_id}/stream
MEDIA_STORAGE_PATH=/var/lib/camera-media
MAX_FRAME_BYTES=4194304
STATS_INTERVAL_SECONDS=60
LOG_FORMAT=json
# Backend HTTP API and event recording always start; no API token is required.
MEDIA_API_HOST=127.0.0.1
MEDIA_API_PORT=8889
FFMPEG_PATH=ffmpeg
MAX_BUFFER_BYTES=2147483648
MAX_CLIP_JOBS=32
